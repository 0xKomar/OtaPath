# OtaPath — environment
# Copy to .env.local and fill in. Supabase is required for the
# production app; everything else has graceful offline fallbacks.

# ── Supabase (required) ──────────────────────────────────────────────
# Project → Settings → API.
# 1. Create a project at https://supabase.com/dashboard
# 2. SQL Editor → paste + run supabase/schema.sql (creates tables,
#    RLS, auth users and the whole demo cohort in one go)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# server-side only — never exposed to the browser. API routes use it
# to read/write clinical tables (RLS denies anon/auth access anyway)
# and to create patient logins via auth.admin.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Demo auto-login (optional, recommended for the live demo) ────────
# When set, the patient app silently signs in with these credentials —
# the /demo iframe + fresh deploys "just work" without a login screen.
# Must match an account seeded by schema.sql or created in the portal.
NEXT_PUBLIC_DEMO_EMAIL=matti@otapath.app
NEXT_PUBLIC_DEMO_PASSWORD=demo1234

# ── ElevenLabs (optional) ────────────────────────────────────────────
# Real music soundscapes + spoken narration. Without it the on-device
# Web Audio synth pad plays instead and narration is silently skipped.
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Optional: pin a narration voice (default: Rachel — calm, warm).
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
